{
  "name": "kotoba-japanese-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node server/index.mjs",
    "data:check": "node scripts/import.mjs --dry-run",
    "data:import": "node scripts/import.mjs",
    "data:translate": "node scripts/course-translate.mjs && node scripts/import.mjs",
    "data:translate:qwen": "node scripts/import.mjs --translate",
    "data:refine": "node scripts/refine-translations.mjs && node scripts/import.mjs",
    "data:repair": "node scripts/repair-translations.mjs && node scripts/import.mjs",
    "audio:setup": "node scripts/audio-setup.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:database": "node scripts/verify-database.mjs",
    "test:learning": "node scripts/verify-learning.mjs",
    "models:serve": "node scripts/ollama.mjs serve",
    "models:pull": "node scripts/ollama.mjs pull",
    "start": "node scripts/start-local.mjs",
    "test:voice": "node scripts/audio-qa.mjs && node scripts/verify-voice.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-vue-next": "^0.468.0",
    "multer": "^2.5.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vue-tsc": "^3.3.14"
  }
}
